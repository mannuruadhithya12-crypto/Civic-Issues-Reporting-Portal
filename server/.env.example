# CivicConnect Server Environment Configuration Template
# Copy this file to .env and replace placeholder values with your secure credentials.
# NEVER commit the actual .env file with secrets into version control.

# MongoDB Connection String (Atlas URI or local mongod)
MONGO_URI=mongodb://localhost:27017/civicconnect

# JWT Secret Key (Must be at least 32 cryptographically random characters in production)
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key_here

# Port to listen on (Default: 5000)
PORT=5000

# Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# Demo Mode Toggle ('true' to enable mock/demo accounts, 'false' in production)
ENABLE_DEMO_MODE=false

# CORS Allowed Origins (Comma-separated list of allowed frontend origins, e.g. https://staging.civicconnect.org)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Persistent File Upload Directory (Optional: defaults to server/uploads)
UPLOAD_DIR=uploads

# Optional: Force in-memory database for isolated offline testing
# FORCE_MEMORY_DB=true

# Google Gemini API Configuration (G1 Core Foundation)
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=2048


