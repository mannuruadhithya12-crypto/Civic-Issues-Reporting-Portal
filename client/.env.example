# CivicConnect Client Environment Configuration Template
# Copy this file to .env or .env.local to customize API base URLs during development or production.

# Base URL for the CivicConnect backend API (Defaults to relative /api when hosted behind reverse proxy)
REACT_APP_API_URL=/api

# Default Map Center (Bangalore municipal center default: 12.9716, 77.5946)
REACT_APP_DEFAULT_LAT=12.9716
REACT_APP_DEFAULT_LNG=77.5946
REACT_APP_DEFAULT_ZOOM=12
